---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Tag from '../../components/Tag.astro';
import StatusBadge from '../../components/StatusBadge.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<BaseLayout title={`${project.data.title} - Anindita Sarker Aloka`} description={project.data.description}>
  <article class="max-w-4xl mx-auto px-4 md:px-6 py-12 md:py-16">

    <!-- Back -->
    <a href="/projects" class="font-mono text-xs opacity-40 hover:opacity-100 transition-opacity inline-flex items-center gap-2 mb-10">
      ← All projects
    </a>

    <!-- Header -->
    <div class="mb-12">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <div class="flex flex-wrap items-center gap-2">
          {project.data.domain.map((d) => (
            <Tag name={d} />
          ))}
          <span class="font-mono text-xs opacity-40 ml-2">
            {new Date(project.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
          </span>
        </div>
        <StatusBadge status={project.data.status} />
      </div>

      <h1 class="font-display text-3xl md:text-5xl font-extrabold leading-tight mb-6">
        {project.data.title}
      </h1>
      <p class="font-body text-lg md:text-xl opacity-75 leading-relaxed">
        {project.data.description}
      </p>
    </div>

    <!-- Divider -->
    <div class="flex gap-1 mb-12">
      <div class="h-1 w-12" style="background: var(--royal);"></div>
      <div class="h-1 w-4" style="background: var(--crimson);"></div>
      <div class="h-1 w-2" style="background: var(--amber);"></div>
    </div>

    <!-- Content -->
    <div class="prose-content">
      <Content />
    </div>

  </article>

  <!-- Image Lightbox Modal for Phone / Desktop viewability -->
  <div id="image-lightbox" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden items-center justify-center p-4 transition-opacity duration-300">
    <button id="close-lightbox" class="absolute top-4 right-4 text-white/80 hover:text-white font-mono text-2xl p-2 z-50 bg-white/10 hover:bg-white/20 rounded-full w-10 h-10 flex items-center justify-center transition-colors">
      ✕
    </button>
    <div class="relative max-w-5xl max-h-[90vh] flex flex-col items-center justify-center">
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[82vh] object-contain rounded-lg border border-white/20 shadow-2xl" />
      <p id="lightbox-caption" class="text-white/80 text-xs md:text-sm font-mono mt-3 text-center px-4"></p>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const lightbox = document.getElementById('image-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('close-lightbox');

    if (!lightbox || !lightboxImg || !lightboxCaption || !closeBtn) return;

    const images = document.querySelectorAll('.prose-content img');
    images.forEach((img) => {
      const htmlImg = img as HTMLImageElement;
      htmlImg.classList.add('cursor-zoom-in');
      htmlImg.addEventListener('click', () => {
        lightboxImg.src = htmlHtmlSrc(htmlImg.src);
        lightboxCaption.textContent = htmlImg.alt || '';
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden';
      });
    });

    function htmlHtmlSrc(src: string) {
      return src;
    }

    const closeLightbox = () => {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
    };

    closeBtn.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || e.target === lightbox.firstElementChild) {
        closeLightbox();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) {
        closeLightbox();
      }
    });
  });
</script>

<style>
  .prose-content :global(h2) {
    font-family: 'Graviton', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }
  .prose-content :global(h3) {
    font-family: 'Graviton', sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }
  .prose-content :global(p) {
    line-height: 1.7;
    margin-bottom: 0.75rem;
    opacity: 0.85;
  }
  .prose-content :global(ul) {
    list-style: none;
    padding: 0;
    margin-bottom: 1rem;
  }
  .prose-content :global(ul li) {
    margin-bottom: 0.375rem;
    line-height: 1.5;
  }
  .prose-content :global(ul li)::before {
    content: '→ ';
    color: var(--crimson);
    font-weight: 600;
  }
  .prose-content :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875em;
    background-color: var(--bg-surface);
    padding: 0.125rem 0.375rem;
    border-radius: 2px;
  }
  .prose-content :global(strong) {
    font-weight: 600;
    color: var(--text-primary);
  }
  .prose-content :global(blockquote) {
    border-left: 3px solid var(--amber);
    padding-left: 1.25rem;
    margin: 1.25rem 0;
    opacity: 0.85;
    font-style: italic;
  }
  .prose-content :global(img) {
    width: 100%;
    border-radius: 6px;
    border: 1px solid var(--border);
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .prose-content :global(figure img) {
    margin-top: 0;
    margin-bottom: 0;
    border: none;
  }

  .prose-content :global(.photo-card-royal) {
    border: 1px solid color-mix(in srgb, var(--royal) 15%, var(--border));
    background-color: var(--bg);
    padding: 0.75rem;
    box-shadow: 3px 3px 0px color-mix(in srgb, var(--royal) 10%, transparent);
    transition: all 0.2s ease;
  }
  .prose-content :global(.photo-card-royal:hover) {
    border-color: color-mix(in srgb, var(--royal) 60%, var(--border));
    box-shadow: 4px 4px 0px color-mix(in srgb, var(--royal) 20%, transparent);
    transform: translate(-1px, -1px);
  }

  .prose-content :global(.photo-card-crimson) {
    border: 1px solid color-mix(in srgb, var(--crimson) 15%, var(--border));
    background-color: var(--bg);
    padding: 0.75rem;
    box-shadow: 3px 3px 0px color-mix(in srgb, var(--crimson) 10%, transparent);
    transition: all 0.2s ease;
  }
  .prose-content :global(.photo-card-crimson:hover) {
    border-color: color-mix(in srgb, var(--crimson) 60%, var(--border));
    box-shadow: 4px 4px 0px color-mix(in srgb, var(--crimson) 20%, transparent);
    transform: translate(-1px, -1px);
  }

  .prose-content :global(.photo-card-amber) {
    border: 1px solid color-mix(in srgb, var(--amber) 18%, var(--border));
    background-color: var(--bg);
    padding: 0.75rem;
    box-shadow: 3px 3px 0px color-mix(in srgb, var(--amber) 12%, transparent);
    transition: all 0.2s ease;
  }
  .prose-content :global(.photo-card-amber:hover) {
    border-color: color-mix(in srgb, var(--amber) 60%, var(--border));
    box-shadow: 4px 4px 0px color-mix(in srgb, var(--amber) 22%, transparent);
    transform: translate(-1px, -1px);
  }
</style>
