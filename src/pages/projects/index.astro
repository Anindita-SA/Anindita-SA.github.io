---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Tag from '../../components/Tag.astro';
import StatusBadge from '../../components/StatusBadge.astro';

const allProjects = (await getCollection('projects'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const domains = ['All', 'Renewables', 'Electronics', 'Product Design', 'Research'];
---

<BaseLayout title="Projects - Anindita Sarker Aloka" description="Engineering and design projects across renewables, electronics, and product design.">

  <section class="max-w-5xl mx-auto px-6 py-16">
    <p class="section-label mb-4">Work</p>
    <h1 class="font-display text-5xl font-extrabold mb-4">Projects</h1>
    <p class="font-body text-lg opacity-60 max-w-xl mb-12">
      A collection of things I've built, researched, and shipped - across disciplines, on purpose.
    </p>

    <!-- Filter tabs + status toggle -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-12">
      <div class="flex flex-wrap gap-2" id="filter-tabs">
        {domains.map(domain => (
          <button
            data-filter={domain}
            class={`font-mono text-xs px-4 py-2 border transition-all duration-200 filter-btn ${domain === 'All' ? 'active' : ''}`}
            style="border-color: var(--border);"
          >
            {domain}
          </button>
        ))}
      </div>
      <label class="flex items-center gap-2 cursor-pointer shrink-0">
        <span class="toggle-switch">
          <input type="checkbox" id="status-toggle" />
          <span class="toggle-track"></span>
        </span>
        <span class="font-mono text-xs opacity-50">Include early-stage</span>
      </label>
    </div>

    <!-- Projects grid -->
    <div class="grid gap-4" id="projects-grid">
      {allProjects.map((project, i) => (
        <a
          href={`/projects/${project.slug}`}
          data-domains={project.data.domain.join(',')}
          data-status={project.data.status}
          class={`project-card group block p-6 border transition-all duration-300 hover:translate-y-[-2px] animate-on-scroll ${['Concept', 'Planned'].includes(project.data.status) ? 'hidden' : ''}`}
          style={`border-color: var(--border); background-color: var(--bg); animation-delay: ${i * 0.05}s;`}
        >
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <div class="flex flex-wrap gap-2">
              {project.data.domain.map((d) => (
                <Tag name={d} />
              ))}
            </div>
            <StatusBadge status={project.data.status} />
          </div>
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex-1">
              <h2 class="font-display text-lg font-bold mb-1 group-hover:opacity-70 transition-opacity">
                {project.data.title}
              </h2>
              <p class="font-body text-sm opacity-60">{project.data.description}</p>
            </div>
            <span class="font-mono text-xs opacity-30 shrink-0">
              {new Date(project.data.date).getFullYear()} →
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .filter-btn.active {
    background-color: var(--royal);
    color: white;
    border-color: var(--royal);
  }
  .dark .filter-btn.active {
    background-color: var(--amber);
    color: #000;
    border-color: var(--amber);
  }
  .project-card.hidden {
    display: none;
  }
</style>

<script is:inline>
  const buttons = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.project-card');
  const toggle = document.getElementById('status-toggle');

  function applyFilters() {
    const activeBtn = document.querySelector('.filter-btn.active');
    const filter = activeBtn ? activeBtn.dataset.filter : 'All';
    const showEarly = toggle && toggle.checked;

    cards.forEach(card => {
      const domains = card.dataset.domains || '';
      const status = card.dataset.status || '';
      const isEarlyStage = status === 'Concept' || status === 'Planned';

      if (isEarlyStage && !showEarly) {
        card.classList.add('hidden');
        return;
      }

      if (filter === 'All' || domains.includes(filter)) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      applyFilters();
    });
  });

  if (toggle) {
    toggle.addEventListener('change', applyFilters);
  }
</script>
